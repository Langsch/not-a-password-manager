# Copy to .env and fill both values in.

# Password for the PostgreSQL role the service uses.
POSTGRES_PASSWORD=change-me

# 32 random bytes, base64. Generate one with:
#   docker run --rm python:3.13-alpine python -c \
#     "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Back this up somewhere that is NOT the database backup. Without it, the
# passwords stored in the database do not come back.
ENCRYPTION_KEY=
