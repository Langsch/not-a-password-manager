/* One vocabulary for the whole app: $primary draws the frames, $accent names
   things, $text-muted labels them, and nothing else carries colour unless it
   is saying something — a revealed password, a warning, a deletion. */

Screen {
    layout: vertical;
    background: $background;
}

ModalScreen {
    align: center middle;
    background: $background 55%;
}

/* --- pieces used on more than one screen -------------------------------- */

Input {
    border: round $panel;
    border-title-color: $text-muted;
    background: $surface;
    height: 3;
}

Input:focus {
    border: round $accent;
    border-title-color: $accent;
}

.card {
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
    height: auto;
    max-height: 100%;
}

.hint {
    color: $text-muted;
    padding-bottom: 1;
}

.status-line {
    height: auto;
    color: $text-muted;
}

.buttons {
    height: auto;
    align-horizontal: right;
    padding-top: 1;
}

.buttons Button {
    margin-left: 2;
    min-width: 14;
}

/* --- signing in --------------------------------------------------------- */

#login-frame {
    align: center middle;
    height: 1fr;
}

#login-card {
    width: 58;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#login-art {
    height: auto;
    /* The drawing is a grid; wrapping it turns it into noise. A terminal too
       narrow for twenty-two columns loses the right edge instead. */
    text-wrap: nowrap;
    text-overflow: clip;
}

.brand-tagline {
    color: $text-muted;
    padding-top: 1;
}

#mode {
    margin-bottom: 1;
}

#login-card .buttons {
    padding-top: 0;
}

/* --- the sidebar -------------------------------------------------------- */

#body {
    height: 1fr;
}

#sidebar {
    width: 28;
    border-right: solid $primary;
    padding: 1 1 0 2;
}

#art {
    height: auto;
    padding-bottom: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

.side-label {
    color: $text-muted;
    text-style: bold;
    padding: 1 0 0 1;
}

#nav {
    background: transparent;
    height: auto;
}

#nav > ListItem {
    background: transparent;
    padding: 0 1;
}

#nav > ListItem.--highlight {
    background: $primary;
    text-style: bold;
}

#meters {
    dock: bottom;
    height: auto;
    padding: 0 0 1 1;
}

.meter {
    height: 1;
}

/* --- the passwords pane ------------------------------------------------- */

#main {
    height: 1fr;
    padding: 1 2;
}

#search {
    width: 1fr;
}

#items {
    width: 1fr;
    height: 1fr;
    margin-top: 1;
    background: $surface;
}

#items > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

/* Six rows: a heading and one row of cards. The table above keeps whatever is
   left, so the pane still shows a useful list on a 24-row terminal. */
#detail {
    dock: bottom;
    height: 6;
    padding-top: 1;
}

#detail-name {
    height: 1;
}

#detail-cards {
    height: 5;
}

#password-card {
    width: 3fr;
    height: 3;
    margin-right: 2;
    padding: 0 2;
}

#notes-card {
    width: 2fr;
    height: 3;
    padding: 0 2;
}

/* --- the account pane --------------------------------------------------- */

#account-card,
#session-card {
    width: 1fr;
    margin-bottom: 1;
}

#signed-in-as {
    padding-bottom: 1;
}

/* --- the small screens -------------------------------------------------- */

#ask {
    width: 56;
}

#secrets {
    width: 72;
}

/* A resolved height, so the field list is what shrinks on a short terminal
   and Save never ends up below the fold. */
#form {
    width: 66;
    height: 1fr;
    max-height: 26;
}

#form-fields {
    height: 1fr;
}

#confirm-card {
    width: 60;
}

.card-heading {
    text-style: bold;
    color: $accent;
}

/* The one place a stored password is on screen inside a modal. */
.secret {
    border: round $accent;
    border-title-color: $accent;
    color: $accent;
    text-style: bold;
    padding: 1 2;
    height: auto;
}

#notes {
    border: round $panel;
    border-title-color: $text-muted;
    padding: 0 2;
    margin-top: 1;
    height: auto;
    max-height: 5;
}
